# Local development defaults. Set your own secret (`openssl rand -base64 32`) for anything shared.
BETTER_AUTH_SECRET=entwine-development-secret-change-me-please
BETTER_AUTH_URL=http://localhost:3000

# Mail is printed in the backend's log. To read it as mail instead, run Mailpit
# (docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit), uncomment this line,
# and open http://localhost:8025.
# SMTP_URL=smtp://localhost:1025

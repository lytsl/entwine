{
  "compilerOptions": {
    "target": "ES2017",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["bun"],
    "isolatedModules": true,
    "jsx": "react-jsx"
  }
}

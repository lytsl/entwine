{
	"name": "entwine",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"arktype": "^2.2.0",
			"typescript": "^6.0.3",
			"@types/bun": "^1.3.14",
			"@types/react": "^19.0.0",
			"hono": "^4.12.21",
			"better-auth": "^1.6.11",
			"@typescript/native-preview": "^7.0.0-dev.20260519.1",
			"@tanstack/react-query": "^5.100.11",
			"drizzle-orm": "beta",
			"@tanstack/intent": "latest",
			"vitest": "^4.1.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"build:types": "turbo -F @entwine/server build:types",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F @entwine/server dev",
		"db:push": "turbo -F @entwine/server db:push",
		"db:studio": "turbo -F @entwine/server db:studio",
		"db:generate": "turbo -F @entwine/server db:generate",
		"db:migrate": "turbo -F @entwine/server db:migrate",
		"db:local": "turbo -F @entwine/server db:local",
		"fix": "biome check --fix .",
		"fix:unsafe": "biome check --fix --unsafe .",
		"clean": "find . -type d -name 'node_modules' -exec rm -rf {} +"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@entwine/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.9.14",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
